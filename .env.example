# Copy to .env and edit as needed. All configuration is read from UTOPIA_-prefixed environment variables.
UTOPIA_DATABASE_URL=postgres://utopia:utopia@localhost:1517/utopia
UTOPIA_BIND_ADDR=0.0.0.0:1516
# JWT signing key. Leave it empty: one is generated on first start and stored in the database.
# Only set it to rotate the key, or to make several instances agree on one explicitly.
# UTOPIA_JWT_SECRET=
# Frontend build output. If the directory exists the server hosts the SPA itself.
UTOPIA_WEB_DIST=web/dist
# Data directory: raw files (files/) and the full-text index (index/).
UTOPIA_DATA_DIR=data
# Force the Secure flag on the session cookie. Leave it empty: behind TLS it is decided from X-Forwarded-Proto.
# Only needed when the reverse proxy does not send that header.
# UTOPIA_COOKIE_SECURE=true
# Open registration. With false only the first user can register; the administrator opens the rest.
UTOPIA_OPEN_REGISTRATION=true
# Database connection pool cap. Default 32, aligned with the default worker concurrency.
# A pool smaller than the concurrency shows up as slow requests, never as anything saying
# "pool exhausted". Revisit this when raising worker concurrency, and stay under Postgres's
# own max_connections (default 100).
# UTOPIA_DB_MAX_CONNECTIONS=32

# --- The following are read by docker-compose, not by the application ---
# Database password. The default is only fit for local development; change it for any public deployment.
# UTOPIA_DB_PASSWORD=utopia
# Database port mapping. Binds loopback only by default, for local development; change it when the host port is taken.
# UTOPIA_DB_BIND=127.0.0.1:1517
# If Docker Hub is unreachable, substitute any PG16+ image that ships pgvector.
# UTOPIA_DB_IMAGE=pgvector/pgvector:pg16
# Pin the deployed version; defaults to latest.
# UTOPIA_IMAGE=ghcr.io/deeplethe/utopia:0.1.0

# --- Least-privilege database role (optional, recommended for new deployments) ---
# Unset, the application runs as the database owner. That identity can DROP TRIGGER, and so
# can bypass the ledger's immutability constraints. Set, the application connects as
# utopia_app instead: business tables read and write as usual, the ledger can only be
# written and read, never modified or deleted; migrations use a separate owner connection
# that is released as soon as they finish.
#
# Note: this layer stops application bugs, SQL injection and leaked connection strings.
# It does not stop someone who can log in to the server (psql inside the container is
# a passwordless superuser). That belongs to server access control.
#
# The init script creates the role on first `up`, so all three must be given together:
# UTOPIA_APP_DB_PASSWORD=replace-with-a-random-password
# UTOPIA_DATABASE_URL=postgres://utopia_app:that-same-password@db:5432/utopia
# UTOPIA_MIGRATION_URL=postgres://utopia:${UTOPIA_DB_PASSWORD}@db:5432/utopia
#
# Deployments whose data directory already exists never run the init script; create the role once by hand:
#   docker compose exec db psql -U utopia -d utopia \
#     -c "CREATE ROLE utopia_app LOGIN PASSWORD 'replace-with-a-random-password';"
# Then set the three lines above and restart; the migration grants it the privileges automatically.
